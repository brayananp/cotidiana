{
  "id": "/",
  "name": "Personal Productivity OS",
  "short_name": "Productivity OS",
  "description": "Tareas, agenda, recordatorios y biblioteca personal con funcionamiento offline.",
  "lang": "es",
  "dir": "ltr",
  "start_url": "/dashboard?source=pwa",
  "scope": "/",
  "display": "standalone",
  "display_override": [
    "window-controls-overlay",
    "standalone",
    "minimal-ui"
  ],
  "orientation": "any",
  "background_color": "#f8fafc",
  "theme_color": "#0f172a",
  "categories": [
    "productivity",
    "utilities",
    "education"
  ],
  "prefer_related_applications": false,
  "icons": [
    {
      "src": "/pwa-192x192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/pwa-512x512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/maskable-icon-512x512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "Tareas",
      "short_name": "Tareas",
      "description": "Abrir la lista de tareas",
      "url": "/tasks?source=pwa-shortcut",
      "icons": [
        {
          "src": "/pwa-192x192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Agenda",
      "short_name": "Agenda",
      "description": "Abrir la agenda semanal",
      "url": "/scheduling?source=pwa-shortcut",
      "icons": [
        {
          "src": "/pwa-192x192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Recordatorios",
      "short_name": "Recordatorios",
      "description": "Abrir los recordatorios",
      "url": "/reminders?source=pwa-shortcut",
      "icons": [
        {
          "src": "/pwa-192x192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Biblioteca",
      "short_name": "Biblioteca",
